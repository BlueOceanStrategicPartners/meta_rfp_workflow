DJANGO_SETTINGS_MODULE=config.settings.local_sqlite
DJANGO_DEBUG=true
USE_FIXTURE_DEBATE=true
USE_SEAMLESS_FIXTURE=true
# Neural dev voice when Seamless weights are not loaded (requires edge-tts; needs network)
EDGE_NEURAL_TTS=true
EDGE_NEURAL_VOICE=en-US-AriaNeural
SEAMLESS_M4T_V2_MODEL=facebook/seamless-m4t-v2-large
SEAMLESS_M4T_DEVICE=cpu
CELERY_TASK_ALWAYS_EAGER=true
META_MODEL_API_KEY=
# Optional alias (same value as META_MODEL_API_KEY):
LLM_API_KEY=
# ASR_BACKEND=faster_whisper (local Whisper, ~500MB small.en) | omniasr | muse (cloud)
ASR_BACKEND=faster_whisper
FASTER_WHISPER_MODEL=small.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_LANGUAGE=en
# Prefer onnx with llama.cpp on GPU (no PyTorch CUDA): fast-omniasr + ONNX Runtime
OMNIASR_RUNTIME=onnx
# 300M = default (~650MB fp16 cache); 1B = optional, ~2GB+ download
OMNIASR_ONNX_MODEL=EmreAkgul/omniASR-CTC-300M-v2-ONNX
OMNIASR_ONNX_PRECISION=fp16
OMNIASR_MODEL_HF=aadel4/omniASR-CTC-300M-v2
OMNIASR_DEVICE=cuda
# Torch fallback only: OMNIASR_RUNTIME=torch and pip install torch+transformers
# Muse Voice Transcribe realtime (only when ASR_BACKEND=muse)
MUSE_VOICE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# ENDPOINTING = orb toggle / voice agent; PUSH_TO_TALK = single turn until endStream
MUSE_ASR_MODE=ENDPOINTING
REDIS_URL=redis://127.0.0.1:6379/0
