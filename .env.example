DJANGO_SETTINGS_MODULE=config.settings.local_sqlite
DJANGO_DEBUG=true
USE_FIXTURE_DEBATE=true
USE_SEAMLESS_FIXTURE=true
# Neural dev voice when Seamless weights are not loaded (requires edge-tts; needs network)
EDGE_NEURAL_TTS=true
EDGE_NEURAL_VOICE=en-US-AriaNeural
SEAMLESS_M4T_V2_MODEL=facebook/seamless-m4t-v2-large
SEAMLESS_M4T_DEVICE=cpu
CELERY_TASK_ALWAYS_EAGER=true
META_MODEL_API_KEY=
META_MODEL_WONDER=muse-wonder-1.0
# Designer Panel design agent (defaults to META_MODEL_WONDER when unset)
META_MODEL_DESIGNER=muse-wonder-1.0
META_MODEL_SPARK=muse-spark-1.3
# Client RFP voice assistant — Muse Spark (fast). Contributor tier: muse-spark-1.3-contributor
META_MODEL_CLIENT_ASSISTANT=muse-spark-1.3
META_MODEL_CLIENT_ASSISTANT_REASONING_EFFORT=low
# Truncate-log Muse chat/completions request previews and responses (restart backend after change)
META_MODEL_DEBUG=false
META_MODEL_DEBUG_MAX_CHARS=4000
META_MODEL_HTTP_TIMEOUT=300
DESIGNER_TOOL_LOOP_MAX_TURNS=1000
DESIGNER_TOOL_LOOP_REPAIR_MAX_TURNS=1000
# LangGraph checkpoint store: sqlite | memory
DESIGNER_LANGGRAPH_CHECKPOINT_BACKEND=sqlite
# Optional alias (same value as META_MODEL_API_KEY):
LLM_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
